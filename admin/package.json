{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/admin",
  "version": "0.0.2",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "proto"
  ],
  "description": "TypeScript client for the Canton participant admin gRPC API",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js",
      "default": "./lib/src/index.js"
    }
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "pnpm codegen && tsgo -p tsconfig.json && tsc-alias -p tsconfig.json",
    "compile": "tsgo -p tsconfig.json && tsc-alias -p tsconfig.json",
    "watch": "tsgo --watch",
    "clean": "rm -rf lib src/generated",
    "prepare": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@grpc/grpc-js": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "grpc-tools": "^1.12.4",
    "ts-proto": "^2.5.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.11.0",
    "vitest": "^4.0.18"
  }
}
