{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/ledger",
  "version": "0.0.20",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "lib-lite",
    "spec",
    "scripts",
    "BUILD.md"
  ],
  "description": "OpenAPI v2 compatible Daml ledger client",
  "exports": {
    ".": {
      "import": "./lib/src/index.js",
      "types": "./lib/src/index.d.ts"
    },
    "./lite": {
      "import": "./lib-lite/src/index.js",
      "types": "./lib-lite/src/index.d.ts"
    },
    "./sets": {
      "import": "./lib/src/sets.js",
      "types": "./lib/src/sets.d.ts"
    }
  },
  "bin": {
    "ledger-build": "./scripts/build.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts --sdk-version=3.5.1-snapshot.20260423.18760.0",
    "compile": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "watch": "tsc --watch",
    "clean": "rm -rf lib lib-lite src/generated",
    "prepare": "pnpm build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint --ext .ts src/"
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "eventemitter3": "^5.0.1",
    "isomorphic-ws": "^5.0.0",
    "jose": "^6.0.10"
  },
  "peerDependencies": {
    "@daml/types": ">=3.4.0 <4.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@daml/types": "3.4.9",
    "@types/ajv": "^0.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.11",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.4.2",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.11.0",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
