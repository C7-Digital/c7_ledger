{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/ledger",
  "version": "0.0.42",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "lib-lite",
    "specs",
    "scripts",
    "BUILD.md"
  ],
  "description": "OpenAPI v2 compatible Daml ledger client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C7-Digital/c7_ledger.git",
    "directory": "ledger"
  },
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js",
      "default": "./lib/src/index.js"
    },
    "./lite": {
      "types": "./lib-lite/src/index.d.ts",
      "import": "./lib-lite/src/index.js",
      "default": "./lib-lite/src/index.js"
    },
    "./sets": {
      "types": "./lib/src/sets.d.ts",
      "import": "./lib/src/sets.js",
      "default": "./lib/src/sets.js"
    }
  },
  "bin": {
    "ledger-build": "./scripts/build.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts --sdk-version=3.5.1-snapshot.20260423.18760.0",
    "compile": "tsgo -p tsconfig.json && tsc-alias -p tsconfig.json",
    "watch": "tsgo --watch",
    "clean": "rm -rf lib lib-lite src/generated",
    "prepare": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "eventemitter3": "^5.0.1",
    "isomorphic-ws": "^5.0.0",
    "jose": "^6.0.10"
  },
  "peerDependencies": {
    "@daml/types": ">=3.4.0 <4.0.0",
    "yaml": "^2.8.1"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@daml/types": "3.4.11",
    "@types/ajv": "^0.0.5",
    "@types/node": "^18.15.11",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "openapi-typescript": "^7.4.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.11.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.1"
  }
}
