{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["scripts/**/*"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/lib", "**/lib-lite"],
  "references": [
    { "path": "./ledger" },
    { "path": "./react" },
    { "path": "./scribe" },
    { "path": "./scan" },
    { "path": "./admin" }
  ]
}
