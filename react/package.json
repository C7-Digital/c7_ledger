{
  "name": "@c7-digital/react",
  "version": "0.0.26",
  "description": "React hooks for Daml ledger integration using Canton JSON API v2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C7-Digital/c7_ledger.git",
    "directory": "react"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsgo",
    "dev": "tsgo --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepare": "tsgo",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "daml",
    "canton",
    "react",
    "hooks",
    "ledger",
    "blockchain"
  ],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@c7-digital/ledger": ">=0.0.33 <0.1.0",
    "@daml/types": ">=3.4.0 <4.0.0",
    "react": "^18.0.0",
    "react-oidc-context": "^3.3.0",
    "oidc-client-ts": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "react-oidc-context": {
      "optional": true
    },
    "oidc-client-ts": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@c7-digital/ledger": "file:../ledger",
    "@daml/types": "3.4.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsdom": "^25.0.1",
    "oidc-client-ts": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  }
}
