{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/scan",
  "version": "0.0.6",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "specs",
    "scripts"
  ],
  "description": "TypeScript client for the Canton Network Scan API",
  "exports": {
    ".": {
      "import": "./lib/src/index.js",
      "types": "./lib/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts --splice-version=0.5.10",
    "compile": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "watch": "tsc --watch",
    "clean": "rm -rf lib src/generated lib/_vendor",
    "prepare": "pnpm build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests"
  },
  "dependencies": {
    "@daml/types": "3.4.9",
    "@mojotech/json-type-validation": "^3.1.0",
    "cross-fetch": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.11",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.4.2",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.11.0",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
