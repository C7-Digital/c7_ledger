{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/pqs",
  "version": "0.0.2",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "description": "Typed TypeScript client for the Canton Participant Query Store (PQS)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C7-Digital/c7_ledger.git",
    "directory": "pqs"
  },
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js",
      "default": "./lib/src/index.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "clean": "rm -rf lib",
    "prepare": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  },
  "peerDependencies": {
    "@c7-digital/ledger": ">=0.0.23 <0.1.0",
    "@daml/types": ">=3.4.0 <4.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@c7-digital/ledger": "file:../ledger",
    "@daml/types": "3.4.11",
    "@types/node": "^18.15.11",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vitest": "^4.0.18"
  }
}
