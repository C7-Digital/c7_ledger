{
  "name": "@c7-digital/monorepo",
  "version": "0.0.10",
  "private": true,
  "description": "Monorepo containing @c7-digital/ledger, @c7-digital/react, and @c7-digital/scribe packages",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --filter=!@c7-digital/splice-codegen exec tsgo --noEmit -p tsconfig.json",
    "release": "pnpm exec tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsx": "^4.21.0"
  }
}
