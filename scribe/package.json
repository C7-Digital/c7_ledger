{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@c7-digital/scribe",
  "version": "0.0.5",
  "type": "module",
  "description": "Transform DAML codegen output into unified TypeScript packages for use with @c7-digital/ledger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C7-Digital/c7_ledger.git",
    "directory": "scribe"
  },
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/src/index.js",
      "default": "./lib/src/index.js"
    },
    "./vite": {
      "types": "./lib/src/vite-plugin.d.ts",
      "import": "./lib/src/vite-plugin.js",
      "default": "./lib/src/vite-plugin.js"
    }
  },
  "bin": {
    "scribe": "./lib/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc --watch",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "glob": "^10.0.0",
    "semver": "^7.7.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.3",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
