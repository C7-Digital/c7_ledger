module TestModel where

import DA.Time (RelTime, seconds)

-- | A simple asset template for e2e testing.
template Asset
  with
    owner : Party
    description : Text
    value : Int
  where
    signatory owner

    choice Transfer : ContractId Asset
      with
        newOwner : Party
      controller owner
      do create this with owner = newOwner

    choice UpdateValue : ContractId Asset
      with
        newValue : Int
      controller owner
      do create this with value = newValue

-- | An interface for transferable assets.
data TransferableView = TransferableView
  with
    tOwner : Party
  deriving (Eq, Show)

interface Transferable where
  viewtype TransferableView
  getOwner : Party

  choice InterfaceTransfer : ContractId Transferable
    with
      iNewOwner : Party
    controller getOwner this
    do
      create (toInterface @Transferable (ManagedAsset (getOwner this) "" 0 iNewOwner (seconds 0)))

-- | A managed asset that implements the Transferable interface.
template ManagedAsset
  with
    manager : Party
    label : Text
    amount : Int
    delegate : Party
    holdFor : RelTime
      -- ^ A standard-library type, generated into a package of its own.
  where
    signatory manager
    observer delegate

    interface instance Transferable for ManagedAsset where
      view = TransferableView with tOwner = manager
      getOwner = manager
